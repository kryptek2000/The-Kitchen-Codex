  "themeRootCause": {
    "reportedDefect": "Dark page surface with a Warm Parchment-dark heading (and white cards with light text) after a partial theme application.",
    "mechanism": "The theme was applied to two scopes: documentElement (html) and the App root. A partial/external theme change updated only html, so legacy hard-coded class remaps ([[data-theme=\"parchment\"] .bg-[#141414]]) turned cards white while the App root still declared the Obsidian semantic variables. The old heading also used text-white, which the Parchment remap turned dark.",
    "exampleFailedPairs": [
      {
        "foreground": "#1C1917 (Parchment remapped text-white)",
        "background": "#0C0C0C (Obsidian root retained by App root scope)",
        "ratio": 1.1
      },
      {
        "foreground": "#F3F4F6 (Obsidian text-primary retained by App root scope)",
        "background": "#FFFFFF (Parchment remapped card surface)",
        "ratio": 1.09
      }
    ],
    "correction": [
      "documentElement is the single theme scope; the App root no longer renders data-theme",
      "theme is applied in useLayoutEffect before paint and native color-scheme follows the palette",
      "title/hero/card foregrounds and surfaces use semantic roles",
      "hard-coded body bg class removed; html/body/#root share var(--bg-root)",
      "new --accent-contrast role is defined from each approved palette for filled actions"
    ],
    "currentPairsValidated": true,
    "minimumValidatedContrast": 5.18
  },

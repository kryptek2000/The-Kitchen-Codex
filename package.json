{
  "name": "the-kitchen-codex",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "VITE_TKC_BUILD_COMMIT=$(git rev-parse HEAD) VITE_TKC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) vite build && TKC_BUILD_COMMIT=$(git rev-parse HEAD) TKC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --define:process.env.NODE_ENV='\"production\"' --define:process.env.TKC_BUILD_COMMIT='\"'$(git rev-parse HEAD)'\"' --define:process.env.TKC_BUILD_TIME='\"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"' --outfile=dist/server.cjs && node -e \"const fs=require('fs');fs.cpSync('server/voice','dist/voice',{recursive:true})\"",
    "build:plugin": "node plugin/build.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prod": "tsx scripts/verify_prod_serve.ts",
    "test:nutrition:browser": "tsx scripts/verify_advanced_nutrition_browser_prod.ts",
    "test:plugin:isolation": "tsx scripts/verify_plugin_isolation.ts",
    "generate:usda-bundle": "tsx scripts/usda_bundle/generate.cli.ts",
    "verify:usda-bundle": "tsx scripts/usda_bundle/verify.cli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "js-yaml": "^5.3.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-node": "1.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# This is used ONLY server-side and is never sent to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST: The network interface the server binds to.
# Defaults to "127.0.0.1" (loopback) so the app is local-only unless exposed.
# Set to "0.0.0.0" to listen on all interfaces (public deployment). AI Studio
# supplies the host it needs at runtime; leave unset for local development.
# HOST="127.0.0.1"

# PORT: The server port. Defaults to 3000.
# PORT="3000"

# AI_ENDPOINT_TOKEN: Optional shared bearer token that protects the AI endpoints
# (/api/estimate-nutrition, /api/recover-metadata, /api/grab-recipe) against
# public abuse when the app is deployed to a public host.
#
# When set, clients must send `Authorization: Bearer <AI_ENDPOINT_TOKEN>` with
# every request to those endpoints; otherwise they receive HTTP 401. The
# server-side GEMINI_API_KEY is never exposed to the browser.
#
# When UNSET (local development), the AI endpoints are open and require no
# configuration — the default 127.0.0.1 binding keeps the app local-only.
# For a public deployment (HOST=0.0.0.0), set a strong random token here.
# AI_ENDPOINT_TOKEN=""

# RECIPE_IMPORT_RATE_LIMIT: Maximum recipe import requests per minute per IP. Defaults to 15.
RECIPE_IMPORT_RATE_LIMIT="15"

# NUTRITION_RATE_LIMIT: Maximum nutrition estimation requests per minute per IP. Defaults to 20.
NUTRITION_RATE_LIMIT="20"

# METADATA_RECOVERY_RATE_LIMIT: Maximum metadata recovery requests per minute per IP. Defaults to 25.
METADATA_RECOVERY_RATE_LIMIT="25"

# TRUST_PROXY: Number of trusted reverse-proxy hops in front of this app.
# Leave unset when running locally (recommended). When deployed behind a trusted
# reverse proxy or Cloud Run, set to the number of proxy hops (e.g. "1") so the
# real client IP is used for rate limiting. X-Forwarded-For is never trusted
# unless the number of proxy hops is specified here.
TRUST_PROXY=""

# CSP_FRAME_ANCESTORS: Allowed iframe parent origins for the production Content
# Security Policy. Defaults to "'none'" for strict clickjacking protection.
# To allow embedding (e.g. in Obsidian webview or preview containers), configure
# allowed origins (e.g. "'self' https://ai.studio").
# CSP_FRAME_ANCESTORS="'none'"


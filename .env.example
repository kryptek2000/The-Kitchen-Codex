# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RECIPE_IMPORT_RATE_LIMIT: Maximum recipe import requests per minute per IP. Defaults to 15.
RECIPE_IMPORT_RATE_LIMIT="15"

# NUTRITION_RATE_LIMIT: Maximum nutrition estimation requests per minute per IP. Defaults to 20.
NUTRITION_RATE_LIMIT="20"

# TRUST_PROXY: Number of trusted reverse-proxy hops in front of this app.
# Leave unset when running locally (recommended). When deployed behind a trusted
# reverse proxy or Cloud Run, set to the number of proxy hops (e.g. "1") so the
# real client IP is used for rate limiting. X-Forwarded-For is never trusted
# unless the number of proxy hops is specified here.
TRUST_PROXY=""

